{
  "expo": {
    "name": "Stride",
    "slug": "stride",
    "owner": "maxscs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stride",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.maxcerviskinner.stride",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F6F6",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F6F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Stride reads your running workouts from Apple Health so runs from your watch appear automatically.",
          "NSHealthUpdateUsageDescription": "Stride only reads workouts from Apple Health and never writes data back.",
          "background": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Stride uses the camera to record your running form and scan food barcodes.",
          "microphonePermission": "Stride records audio as part of running-form video clips.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stride lets you pick a running clip from your library to analyze your form."
        }
      ],
      "expo-video",
      "./plugins/withoutPushEntitlement"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5a976b14-e38b-45f1-bcc2-7c18554dd90c"
      }
    }
  }
}
